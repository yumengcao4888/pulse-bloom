generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Healer {
  id        Int      @id @default(autoincrement())
  clerkId   String?  @unique
  name        String   @db.Text
  pronouns    String?
  modality    String
  focus       String
  location    String?
  contact     String?
  contactType ContactType?
  bio         String

  slug        String @unique
  reflections Reflection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ContactType {
  email
  phone
  website
  social
}

model Reflection {
  id Int @id @default(autoincrement())

  grounded  Boolean?
  supported Boolean?
  connected Boolean?

  feeling   String?
  emotionalWarmth Decimal? @db.Decimal(5, 2)

  healer   Healer @relation(fields: [healerId], references: [id])
  healerId Int

  createdAt DateTime @default(now())
}
